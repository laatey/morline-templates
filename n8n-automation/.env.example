# Basic auth for the editor UI — strongly recommended once this is public
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

# Required for webhooks to generate correct public URLs
WEBHOOK_URL=https://your-n8n-domain.example.com/

# Encrypts stored credentials — generate once, keep it stable across restarts
# (losing it makes previously-saved credentials unreadable)
N8N_ENCRYPTION_KEY=generate-a-random-32-char-string

GENERIC_TIMEZONE=UTC

# By default n8n uses an embedded SQLite database at /home/node/.n8n/database.sqlite.
# For production, point it at the postgresql template instead:
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=<postgres-host>
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=<user>
# DB_POSTGRESDB_PASSWORD=<password>
