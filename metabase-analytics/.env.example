# Without these, Metabase falls back to an embedded H2 database — fine for
# a quick look, not recommended for anything you plan to keep around.
# Point this at the postgresql template in this same set:
MB_DB_TYPE=postgres
MB_DB_HOST=<postgres-host>
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=<user>
MB_DB_PASS=<password>
